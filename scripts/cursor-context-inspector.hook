# Re-apply the Context Usage popover patch after cursor-bin updates.
# Install: sudo cp scripts/cursor-context-inspector.hook /etc/pacman.d/hooks/
# The Exec path must point at this checkout.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = cursor-bin

[Action]
Description = Patching Cursor Context Usage popover for Agent Context Inspector...
When = PostTransaction
Exec = /usr/bin/python3 /home/kat/Projects/Cursor-extensions/context-inspector/scripts/cursor-popover-patch.py apply
