{
  "name": "context-inspector",
  "displayName": "Agent Context Inspector",
  "description": "See the exact text behind each part of Cursor's agent Context Usage, and keep a local history of agent sessions.",
  "version": "0.8.0",
  "publisher": "local-tools",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.5"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.cjs",
  "bin": {
    "cursor-context": "./bin/cursor-context.cjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cursorContextInspector.open",
        "title": "Inspect Agent Context",
        "category": "Context Inspector",
        "icon": "$(layers)"
      },
      {
        "command": "cursorContextInspector.openHistory",
        "title": "Open Session History Folder",
        "category": "Context Inspector"
      },
      {
        "command": "cursorContextInspector.recordAllHistory",
        "title": "Record History of All Chats",
        "category": "Context Inspector"
      }
    ],
    "keybindings": [
      {
        "command": "cursorContextInspector.open",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      }
    ],
    "configuration": {
      "title": "Agent Context Inspector",
      "properties": {
        "cursorContextInspector.databasePath": {
          "type": "string",
          "default": "",
          "description": "Path to Cursor's state.vscdb. Empty = detect automatically."
        },
        "cursorContextInspector.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show a \"Context\" button in the status bar."
        },
        "cursorContextInspector.recordHistory": {
          "type": "boolean",
          "default": true,
          "description": "Keep a local history of agent sessions: every prompt message and a snapshot per chat update."
        },
        "cursorContextInspector.historyDirectory": {
          "type": "string",
          "default": "",
          "description": "Where session history is stored. Empty = ~/.cursor-context-history."
        },
        "cursorContextInspector.historyBackfillDays": {
          "type": "number",
          "default": 7,
          "description": "On the first run, also record chats updated in this many past days."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs"
  }
}
