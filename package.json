{
  "name": "context-inspector",
  "displayName": "Agent Context Inspector",
  "description": "Click any part of Cursor's agent Context Usage (system prompt, rules, skills, MCP, subagents, conversation) and see the exact text the model received.",
  "version": "0.4.0",
  "publisher": "local-tools",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.5"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.cjs",
  "bin": {
    "cursor-context": "./bin/cursor-context.cjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cursorContextInspector.open",
        "title": "Inspect Agent Context",
        "category": "Context Inspector",
        "icon": "$(layers)"
      }
    ],
    "keybindings": [
      {
        "command": "cursorContextInspector.open",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      }
    ],
    "configuration": {
      "title": "Agent Context Inspector",
      "properties": {
        "cursorContextInspector.databasePath": {
          "type": "string",
          "default": "",
          "description": "Path to Cursor's state.vscdb. Empty = detect automatically."
        },
        "cursorContextInspector.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show a \"Context\" button in the status bar."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs"
  }
}
