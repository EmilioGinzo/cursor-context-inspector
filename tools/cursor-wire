#!/usr/bin/env bash
# Record Cursor's network traffic through a local mitmproxy (see cursor-wire.py).
#
#   cursor-wire start [--port N]   start the recording proxy in the background
#   cursor-wire stop               stop the proxy this script started
#   cursor-wire status             is it running, where do captures go
#   cursor-wire ca install|remove|status
#                                  trust mitmproxy's CA for Cursor (Chromium's NSS store)
#   cursor-wire launch [--port N] [--any-proxy] [args...]
#                                  start Cursor through the proxy `start` recorded (or
#                                  the one on port N); it must be a mitmdump running
#                                  cursor-wire.py, unless --any-proxy
#   cursor-wire env [--port N] [--any-proxy]
#                                  print the command `launch` runs
#   cursor-wire check [--port N]   list Cursor's processes and flag any that reach :443
#                                  directly instead of through the proxy
#
# Captures, pidfile, port and log live in $CURSOR_WIRE_DIR (default ~/.cursor-wire).
set -euo pipefail

WIRE_DIR=${CURSOR_WIRE_DIR:-$HOME/.cursor-wire}
PIDFILE=$WIRE_DIR/proxy.pid
PORTFILE=$WIRE_DIR/proxy.port
LOG=$WIRE_DIR/proxy.log
ADDON=$(dirname "$(readlink -f "$0")")/cursor-wire.py
CA=$HOME/.mitmproxy/mitmproxy-ca-cert.pem
NSSDB=sql:$HOME/.pki/nssdb
NICK="mitmproxy-local (context-inspector testing)"
CURSOR=${CURSOR_BIN:-/usr/share/cursor/cursor}

die() { echo "cursor-wire: $*" >&2; exit 1; }

mitmdump_bin() {
  command -v mitmdump 2>/dev/null || { [ -x "$HOME/.local/bin/mitmdump" ] && echo "$HOME/.local/bin/mitmdump"; } \
    || die "mitmdump not found; install it with: uv tool install mitmproxy"
}

listening() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

is_port() { [[ $1 =~ ^[0-9]+$ ]] || die "not a port number: $1"; }

cmdline() { tr '\0' ' ' 2>/dev/null <"/proc/$1/cmdline"; }

# Whether pid $1 is a mitmdump running cursor-wire.py (from any checkout).
is_wire_proxy() { cmdline "$1" | grep -q 'mitmdump.*cursor-wire\.py'; }

# The pid in the pidfile, if it is still a cursor-wire proxy.
recorded_pid() {
  local pid; pid=$(cat "$PIDFILE" 2>/dev/null) && is_wire_proxy "$pid" && echo "$pid"
}

# The pid of the proxy this script started, if it is still that process.
our_pid() {
  local pid; pid=$(recorded_pid) && cmdline "$pid" | grep -qF "$ADDON" && echo "$pid"
}

recorded_port() { cat "$PORTFILE" 2>/dev/null; }

cmd_start() {
  local p=8080 pid
  while [ $# -gt 0 ]; do
    case $1 in
      --port) p=${2:?--port needs a number}; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  is_port "$p"
  if pid=$(recorded_pid); then die "already running (pid $pid, port $(recorded_port)) for $WIRE_DIR"; fi
  listening "$p" && die "port $p is already in use by another process; pick one with --port N"
  mkdir -p "$WIRE_DIR"
  setsid "$(mitmdump_bin)" --listen-host 127.0.0.1 -p "$p" -s "$ADDON" --set "wire_dir=$WIRE_DIR" \
    --set flow_detail=0 --set termlog_verbosity=warn </dev/null >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  echo "$p" >"$PORTFILE"
  for _ in $(seq 50); do
    listening "$p" && { echo "recording on 127.0.0.1:$p into $WIRE_DIR (pid $!)"; return; }
    kill -0 $! 2>/dev/null || break
    sleep 0.2
  done
  rm -f "$PIDFILE" "$PORTFILE"
  tail -n 20 "$LOG" >&2
  die "the proxy did not start; log: $LOG"
}

cmd_stop() {
  local pid
  if ! pid=$(recorded_pid); then
    rm -f "$PIDFILE" "$PORTFILE"  # stale: that process is gone
    die "not running (no proxy started by this script)"
  fi
  our_pid >/dev/null || die "pid $pid was started from another checkout ($(cmdline "$pid")); stop it with that one's script"
  kill "$pid"
  for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  rm -f "$PIDFILE" "$PORTFILE"
  echo "stopped (pid $pid)"
}

cmd_status() {
  local pid p
  if pid=$(recorded_pid); then
    echo "running: pid $pid on 127.0.0.1:$(recorded_port), recording into $WIRE_DIR"
  else
    echo "not running (no proxy started by this script)"
    p=$(recorded_port) || p=8080
    listening "$p" && echo "note: something else is listening on 127.0.0.1:$p"
  fi
  echo "log: $LOG"
  if command -v certutil >/dev/null; then cmd_ca status; else echo "CA: certutil not found"; fi
}

cmd_ca() {
  command -v certutil >/dev/null || die "certutil not found (package nss / libnss3-tools)"
  case ${1:-status} in
    install)
      if [ ! -f "$CA" ]; then
        # mitmproxy creates its CA the first time it runs.
        "$(mitmdump_bin)" --listen-host 127.0.0.1 -p 0 >/dev/null 2>&1 &
        local pid=$!
        for _ in $(seq 100); do [ -f "$CA" ] && break; sleep 0.1; done
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true
        [ -f "$CA" ] || die "mitmdump did not create $CA"
      fi
      mkdir -p "$HOME/.pki/nssdb"
      [ -f "$HOME/.pki/nssdb/cert9.db" ] || certutil -d "$NSSDB" -N --empty-password
      certutil -d "$NSSDB" -A -t "C,," -n "$NICK" -i "$CA"
      echo "trusted $CA as \"$NICK\""
      ;;
    remove)
      certutil -d "$NSSDB" -D -n "$NICK" && echo "removed \"$NICK\""
      ;;
    status)
      if certutil -d "$NSSDB" -L -n "$NICK" >/dev/null 2>&1; then
        echo "CA trusted: \"$NICK\" ($CA)"
      else
        echo "CA not trusted; run: cursor-wire ca install"
      fi
      ;;
    *) die "usage: cursor-wire ca install|remove|status" ;;
  esac
}

# The pid of the process listening on 127.0.0.1:$1, if this user owns it.
listener_pid() { ss -Hltnp "src 127.0.0.1:$1" 2>/dev/null | grep -o 'pid=[0-9]*' | head -n 1 | cut -d= -f2; }

# launch and env: never fall back to a default port, so a test can't reach a real proxy by accident.
cmd_launch() {
  local print=$1 p any="" pid; shift
  p=$(recorded_port) || p=""
  while [ $# -gt 0 ]; do
    case $1 in
      --port) p=${2:?--port needs a number}; shift 2 ;;
      --any-proxy) any=1; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [ -n "$p" ] || die "no proxy recorded in $PORTFILE; run: cursor-wire start (or pass --port N)"
  is_port "$p"
  listening "$p" || die "no proxy listening on 127.0.0.1:$p; run: cursor-wire start"
  if [ -z "$any" ]; then
    pid=$(listener_pid "$p")
    [ -n "$pid" ] && is_wire_proxy "$pid" \
      || die "127.0.0.1:$p is not a mitmdump running cursor-wire.py; pass --any-proxy to use it anyway"
  fi
  [ -f "$CA" ] || die "no mitmproxy CA at $CA; run: cursor-wire ca install"
  local proxy=http://127.0.0.1:$p
  # Cursor's MCP process (remote MCP servers, e.g. Atlassian's) ignores NODE_EXTRA_CA_CERTS: it
  # trusts what Cursor's main process loads, which includes Node's system store, and that follows
  # SSL_CERT_FILE. So it points at the system bundle plus mitmproxy's CA; OpenSSL tools the agent
  # runs (curl, git) then trust the proxy too.
  local base="" f bundle=$WIRE_DIR/ca-bundle.pem
  for f in "${SSL_CERT_FILE:-}" /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
    if [ -n "$f" ] && [ -f "$f" ] && [ "$f" != "$bundle" ]; then base=$f; break; fi
  done
  [ -n "$base" ] || die "no system CA bundle found; set SSL_CERT_FILE to one"
  mkdir -p "$WIRE_DIR"
  { cat "$base"; echo; cat "$CA"; } >"$bundle.tmp" && mv "$bundle.tmp" "$bundle"
  # Chromium follows --proxy-server; Cursor's Node children, such as the agent worker, only these.
  local env=(NODE_EXTRA_CA_CERTS="$CA" NODE_USE_ENV_PROXY=1 SSL_CERT_FILE="$bundle"
    HTTPS_PROXY="$proxy" https_proxy="$proxy" HTTP_PROXY="$proxy" http_proxy="$proxy"
    NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1)
  local cmd=("$CURSOR" --password-store=gnome-libsecret --proxy-server="$proxy")
  if [ "$print" = print ]; then
    printf '%q ' "${env[@]}" "${cmd[@]}" | sed 's/ $/\n/'
    return
  fi
  exec env "${env[@]}" "${cmd[@]}" "$@"
}

# Cursor's processes, as "pid kind": the app (cursor, or electron running cursor.mjs), the agent
# worker (cursor-agent), and everything they started. Their command lines hold API keys: read
# them here, never print them.
cursor_pids() {
  local d pid ppid stat arg
  local -a argv
  declare -A kind parent
  for d in /proc/[0-9]*; do
    pid=${d#/proc/}
    { read -r stat <"$d/stat" && mapfile -d '' -t argv <"$d/cmdline"; } 2>/dev/null || continue
    stat=${stat##*) }; stat=${stat#* }; parent[$pid]=${stat%% *}
    [[ ${argv[0]:-} =~ (^|/)[Cc]ursor$ ]] && kind[$pid]=cursor
    for arg in "${argv[@]}"; do
      if [[ $arg =~ (^|/)cursor-agent$ ]]; then kind[$pid]=cursor-agent; break; fi
      [[ $arg =~ (^|/)cursor\.mjs$ ]] && kind[$pid]=cursor
    done
  done
  for pid in "${!parent[@]}"; do
    ppid=${parent[$pid]}
    while [ -z "${kind[$pid]:-}" ] && [ "${ppid:-0}" -gt 1 ]; do
      [ -n "${kind[$ppid]:-}" ] && kind[$pid]=${kind[$ppid]}
      ppid=${parent[$ppid]:-0}
    done
  done
  for pid in "${!kind[@]}"; do echo "$pid ${kind[$pid]}"; done | sort -n
}

cmd_check() {
  local p pid kind exe peers direct proxied bad=0 idle=""
  p=$(recorded_port) || p=""
  if [ "${1:-}" = --port ]; then p=${2:?--port needs a number}; fi
  [ -z "$p" ] || is_port "$p"
  local conns; conns=$(ss -Htnp state established 2>/dev/null) || die "ss not found (package iproute2)"
  local list; list=$(cursor_pids)
  [ -n "$list" ] || { echo "no Cursor processes running"; return; }
  while read -r pid kind; do
    exe=$(basename "$(readlink "/proc/$pid/exe" 2>/dev/null)" 2>/dev/null) || exe=?
    peers=$(grep -E "[(,]pid=$pid," <<<"$conns" | awk '{print $4}') || true
    direct=$(grep -E ':443$' <<<"$peers" | grep -vE '^(127\.|\[::1\]|\[::ffff:127\.)' | sort -u | paste -sd ' ') || true
    proxied=$(grep -cxF "127.0.0.1:${p:-none}" <<<"$peers") || true
    if [ -n "$direct" ]; then
      bad=1
      echo "pid $pid $exe ($kind): DIRECT to $direct, not through the proxy"
    elif [ -n "$peers" ]; then
      echo "pid $pid $exe ($kind): ok, $proxied connection(s) via 127.0.0.1:${p:-?}"
    else
      idle+=" $pid"
    fi
  done <<<"$list"
  [ -z "$idle" ] || echo "no connections:$idle"
  [ "$bad" = 0 ] || die "some Cursor traffic bypasses the proxy; was Cursor started with: cursor-wire launch?"
}

case ${1:-} in
  start) shift; cmd_start "$@" ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  ca) shift; cmd_ca "$@" ;;
  launch) shift; cmd_launch run "$@" ;;
  env) shift; cmd_launch print "$@" ;;
  check) shift; cmd_check "$@" ;;
  *) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//'; [ -n "${1:-}" ] && exit 1 || exit 0 ;;
esac
